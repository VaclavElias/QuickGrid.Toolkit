@page "/formatting-styling"

<ExampleInfo Route="formatting-styling"
             Lead="Format values, colour cells by their value, and style whole rows.">
    <p>
        Three levels of styling, from narrowest to widest:
    </p>
    <ul>
        <li><strong>Format strings</strong> — every value helper takes a <code>format</code> applied with the
            invariant culture, so <code>N0</code>, <code>P1</code> or <code>dd MMM yyyy</code> all work.</li>
        <li><strong>Cell styling</strong> — <code>AddStyledNumber</code> wraps the value in
            <code>&lt;span content="..."&gt;</code>. Out of the box the content is <code>positive</code>,
            <code>negative</code> or <code>zero</code>; pass a <code>CellStyleMap</code> to choose your own names
            for specific values. Your CSS then targets <code>td span[content=negative]</code>. Set
            <code>ColumnManager.ValueStyles</code> to choose which of the three are marked up at all — a disabled
            one emits no span, so there is nothing for CSS to undo.</li>
        <li><strong>Row styling</strong> — <code>RowClass</code> returns a class per row, for banding, flagging
            or muting entire records.</li>
    </ul>
    <p>
        <code>ColumnInfo</code> bundles a title, long title and CSS class so the same column definition can be
        reused across grids instead of repeating the strings.
    </p>
</ExampleInfo>

<div class="d-flex align-items-center gap-3 mb-2">
    <span class="small text-muted">Mark up:</span>
    @foreach (var style in _toggleableStyles)
    {
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="@($"value-style-{style}")"
                   checked="@_columnManager.ValueStyles.HasFlag(style)"
                   @onchange="e => ToggleValueStyle(style, (bool)e.Value!)" />
            <label class="form-check-label small" for="@($"value-style-{style}")">@style</label>
        </div>
    }
</div>

<QuickGridWrapper Items="@_items.AsQueryable()"
                  ColumnManager="_columnManager"
                  RowClass="GetRowClass" />

<p class="small text-muted mt-2">
    Over-budget rows are tinted, delivered ones are muted. The <em>Remaining</em> column is coloured by sign,
    and <em>Status</em> uses a <code>CellStyleMap</code> to map each enum value to its own content name.
</p>

<ExampleNav Route="formatting-styling" />

@code {
    private List<ProjectDto> _items = [];
    private ColumnManager<ProjectDto> _columnManager = new();

    /// <summary>Shared definition: title, long title and cell class in one place.</summary>
    private static readonly ColumnInfo BudgetColumn = new("Budget", "Approved budget", "text-end");

    private static readonly GridValueStyles[] _toggleableStyles =
        [GridValueStyles.Negative, GridValueStyles.Positive, GridValueStyles.Zero];

    protected override void OnInitialized()
    {
        _items = ProjectService.GetProjects();

        // Map each status to a content name; CSS in app.css turns those into badges.
        var statusStyles = new CellStyleMap<ProjectStatus>()
            .Add(ProjectStatus.Active, "status-active")
            .Add(ProjectStatus.Planning, "status-planning")
            .Add(ProjectStatus.OnHold, "status-onhold")
            .Add(ProjectStatus.Delivered, "status-delivered");

        _columnManager.AddIndexColumn();
        _columnManager.AddSimple(p => p.Name, fullTitle: "Project name");

        // Format strings: the same helper, three different presentations.
        _columnManager.AddSimpleDate(p => p.StartedOn, "Started", format: "dd MMM yyyy");
        _columnManager.AddSimple(p => p.CompletionRate, "Complete", format: "P0", @class: "text-end");
        // Formats are applied with the invariant culture, so avoid culture-dependent ones such as "C".
        _columnManager.Add(p => p.Budget, BudgetColumn, format: "N0");

        // Styled numbers: positive/negative/zero is applied automatically from the value.
        _columnManager.AddStyledNumber<decimal>(p => p.Spent, "Spent", "Spent to date", format: "N0", @class: "text-end");
        _columnManager.AddStyledNumber<decimal>(p => p.Remaining, "Remaining", "Budget remaining", format: "N0", @class: "text-end");

        // A CellStyleMap replaces that with your own content names, keyed by value.
        _columnManager.AddSimple(p => p.Status, "Status", cellStyle: statusStyles, align: Align.Center);
    }

    /// <summary>
    /// Turns one nature on or off for the whole grid. A real page would set <c>ValueStyles</c> once alongside the
    /// column definitions; it is a live toggle here to show that the setting is read as each cell renders.
    /// </summary>
    private void ToggleValueStyle(GridValueStyles style, bool enabled)
        => _columnManager.ValueStyles = enabled
            ? _columnManager.ValueStyles | style
            : _columnManager.ValueStyles & ~style;

    /// <summary>Runs for every row; the returned class lands on the <c>tr</c>.</summary>
    private string? GetRowClass(ProjectDto project)
    {
        if (project.Remaining < 0) return "row-over-budget";

        return project.Status == ProjectStatus.Delivered ? "row-delivered" : null;
    }
}
