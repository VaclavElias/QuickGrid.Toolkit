@page "/users-grid-wrapper"

<ExampleInfo Route="users-grid-wrapper"
             Lead="The same columns as the QuickGrid example, in an all-in-one component.">
    <p>
        <code>QuickGridWrapper&lt;T&gt;</code> wraps the grid together with a toolbar, quick search across all
        columns, a column selector and optional pagination. You configure the same
        <code>ColumnManager&lt;T&gt;</code> as before and pass it with your <code>Items</code>, there is no
        <code>&lt;QuickGrid&gt;</code> markup to write.
    </p>
    <ul>
        <li>The column setup below is identical to the <a href="users-grid">QuickGrid + ColumnManager</a> example, only the host component changes.</li>
        <li>Try the <strong>quick search</strong> box above the grid; it matches across every column (and nested properties). The settings menu also offers an exact-match toggle.</li>
        <li>To add an automatic totals row, see the <a href="footers-totals">Total Footer</a> example, which builds on this one.</li>
    </ul>
</ExampleInfo>

<div class="form-check form-switch mb-2">
    <input class="form-check-input" type="checkbox" role="switch" id="debug-toggle" @bind="_isDebug" />
    <label class="form-check-label small" for="debug-toggle">Show debug panel (<code>IsDebug</code>)</label>
</div>

<QuickGridWrapper Items="@_items.AsQueryable()"
                  IsDebug="_isDebug"
                  ColumnManager="_columnManager" />

@code {
    private List<UserDto> _items = new();
    private ColumnManager<UserDto> _columnManager = new();
    private bool _isDebug;

    protected override void OnInitialized()
    {
        _columnManager.AddIndexColumn();
        _columnManager.Add(new() { Property = p => p.Id });
        _columnManager.AddSimple(p => p.Name, fullTitle: "Name");
        _columnManager.AddRange(SharedUserColumnManager.Instance.Columns);
        _columnManager.AddToggleColumn(p => p.RemoteWorking, "Remote", fullTitle: "Remote Working", onChange: ToggleChange);
        _columnManager.AddCountry();

        _items = UserService.GetUsers();
    }

    private async Task ToggleChange(UserDto user)
    {
        user.RemoteWorking = !user.RemoteWorking;

        await Task.CompletedTask;

        StateHasChanged();
    }
}
<ExampleNav Route="users-grid-wrapper" />
