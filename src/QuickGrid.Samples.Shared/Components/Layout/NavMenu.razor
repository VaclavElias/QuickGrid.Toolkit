<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">QuickGrid.Samples</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @* Driven by ExampleRegistry, so a new example needs no change here. *@
        @foreach (var example in ExampleRegistry.Examples)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@example.Route">
                    <span class="bi bi-grid-ground-image" aria-hidden="true"></span> @example.Title
                </NavLink>
            </div>
        }

        <div class="nav-item nav-item-icon px-3">
            <NavLink class="nav-link" href="https://github.com/VaclavElias/QuickGrid.Toolkit">
                <i class="bi bi-info-circle"></i> About
            </NavLink>
        </div>
    </nav>
</div>
