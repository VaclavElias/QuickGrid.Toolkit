@* Shared header for the QuickGrid.Toolkit example pages.
   Title, lead and source link all come from ExampleRegistry, so a page only states its own Route. *@

<PageTitle>@_example.Title</PageTitle>

<h1>@_example.Title</h1>

@if (!string.IsNullOrWhiteSpace(Lead))
{
    <p class="lead">@Lead</p>
}

@ChildContent

<p>
    <a href="@($"{SourceBaseUrl}{_example.SourceFile}")" target="_blank" rel="noopener">View the source for this page on GitHub</a>.
</p>

<h2>Live example</h2>

@code {
    private const string SourceBaseUrl =
        "https://github.com/VaclavElias/QuickGrid.Toolkit/blob/main/src/QuickGrid.Samples.Shared/Pages/Examples/";

    private Example _example = default!;

    /// <summary>Route of this example, matching its entry in <see cref="ExampleRegistry"/>.</summary>
    [Parameter, EditorRequired] public string Route { get; set; } = default!;

    /// <summary>Optional one-line summary shown beneath the title. Defaults to the registry summary.</summary>
    [Parameter] public string? Lead { get; set; }

    /// <summary>Optional explanation and key points for the example.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet()
    {
        _example = ExampleRegistry.Find(Route)
            ?? throw new InvalidOperationException($"'{Route}' is not registered in {nameof(ExampleRegistry)}.");

        Lead ??= _example.Summary;
    }
}
